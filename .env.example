# ==========================================
# UPWORK BID AGENT ENVIRONMENT CONFIGURATION
# ==========================================

# --- GENERAL & PORTS ---
NODE_ENV=development
PORT=5679
N8N_PORT=5679
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=false
WEBHOOK_URL=http://localhost:5679/
FRONTEND_URL=http://localhost:5173

# --- DEVELOPMENT LLM STRATEGY (Phase 1) ---
COHERE_API_KEY=your_cohere_api_key_here

# --- PRODUCTION LLM STRATEGY (Phase 2 & 3) ---
GROQ_API_KEY=your_groq_api_key_here

# --- VECTOR STORE (PINECONE) ---
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=upwork-rfp-index
PINECONE_ENVIRONMENT=us-east-1

# --- DATABASE & AUTH (SUPABASE & CLERK) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_key

# --- RENDER FREE-TIER OOM SAFETY FLAGS ---
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000
DB_POSTGRESDB_POOL_SIZE=5
N8N_PAYLOAD_SIZE_MAX=16
N8N_DEFAULT_BINARY_DATA_MODE=filesystem
N8N_METRICS=false
